{
  "name": "@agent-proxy/net-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Internet-spend stack: the in-process hourly nettop collector and the CORS'd HTTP API over the SQLite sample store.",
  "bin": {
    "net-server": "./src/server.ts"
  },
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node --env-file-if-exists=../../.env src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.6.3",
    "vitest": "~3.2.0"
  }
}
