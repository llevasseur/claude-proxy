{
  "name": "ox-alpha-proxy",
  "private": true,
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "proxy": "node --env-file-if-exists=proxy/.env proxy/src/proxy.ts",
    "server": "pnpm --filter @agent-proxy/ox-server start",
    "admin": "pnpm --filter @agent-proxy/ox-admin dev",
    "zellij": "bash scripts/zellij.sh",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "build": "pnpm -r build",
    "check": "biome check .",
    "lint": "biome lint .",
    "format": "biome check --write .",
    "verify": "pnpm typecheck && pnpm test && pnpm build && pnpm check && pnpm anti:slop",
    "anti:slop": "oxlint --config .oxlintrc.json ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@oxlint/plugins": "1.78.0",
    "oxlint": "1.78.0"
  }
}
