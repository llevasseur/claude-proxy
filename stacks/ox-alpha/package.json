{
  "name": "ox-alpha-proxy",
  "private": true,
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "build": "pnpm -r build",
    "check": "pnpm check:docs && biome check .",
    "check:docs": "node scripts/check-docs.mjs",
    "lint": "biome lint .",
    "format": "biome check --write .",
    "verify": "pnpm typecheck && pnpm test && pnpm build && pnpm check && pnpm anti:slop",
    "anti:slop": "oxlint --config .oxlintrc.json .",
    "proxy": "pnpm --filter @ox-alpha-proxy/proxy start",
    "server": "pnpm --filter @ox-alpha-proxy/server start",
    "admin": "pnpm --filter @ox-alpha-proxy/admin dev",
    "zellij": "zellij --layout .zellij/codex-proxy.kdl"
  },
  "devDependencies": {
    "@biomejs/biome": "~2.2.0",
    "oxlint": "~1.12.0",
    "typescript": "~5.9.0"
  }
}
