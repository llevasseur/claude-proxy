# Port and bind address. 8787 is claimed by every sibling proxy on this
# machine, so this one owns 8807. The proxy reads OX_PROXY_PORT first; the
# bare PROXY_PORT below still works and is scoped to this package alone.
PROXY_HOST=127.0.0.1
OX_PROXY_PORT=8807

# Upstream origin the proxy forwards to. api.openai.com 404s the forwarded
# paths.
OPENAI_UPSTREAM=https://opencode.ai

# Boat body capture: OFF by default. Set to 1 to opt in explicitly.
# CAPTURE_BODIES=1
# Directory for redacted capture files (default: captures beside AUDIT_DIR).
# CAPTURE_DIR=./logs/captures
# Extra comma-separated regex patterns redacted before persistence.
# CAPTURE_REDACT_PATTERNS=
