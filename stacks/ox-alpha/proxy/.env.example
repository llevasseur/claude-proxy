# Port and bind address for the transparent proxy.
PROXY_HOST=127.0.0.1
PROXY_PORT=8787

# Upstream OpenAI API base URL the proxy forwards to.
OPENAI_UPSTREAM=https://api.openai.com

# Boat body capture: OFF by default. Set to 1 to opt in explicitly.
# CAPTURE_BODIES=1
# Directory for redacted capture files (default: captures beside AUDIT_DIR).
# CAPTURE_DIR=./logs/captures
# Extra comma-separated regex patterns redacted before persistence.
# CAPTURE_REDACT_PATTERNS=
