// All-up dev session: proxy, server, and dashboard in one tab, plus a spare
// shell. No port is pinned here; each process reads its own env files.
layout {
    tab focus=true name="dev" {
        pane name="proxy" cwd="." {
            command "pnpm"
            args "--filter" "@ox-alpha-proxy/proxy" "start"
        }
        pane name="server" split_direction="vertical" {
            command "pnpm"
            args "--filter" "@ox-alpha-proxy/server" "start"
        }
        pane name="admin" {
            command "pnpm"
            args "--filter" "@ox-alpha-proxy/admin" "dev"
        }
    }
    tab name="shell" {
        pane
    }
}
