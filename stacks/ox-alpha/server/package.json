{
  "name": "@agent-proxy/ox-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "start": "tsx --env-file-if-exists=.env src/main.ts",
    "maintain": "tsx --env-file-if-exists=.env src/maintain.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@agent-proxy/ox-core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "~22.18.0",
    "tsx": "~4.20.0",
    "typescript": "^5.6.3",
    "vitest": "~3.2.0"
  }
}
