# Bind address and port for the local HTTP/SSE API. The server reads
# OX_SERVER_PORT first; the bare SERVER_PORT still works and is scoped to this
# package alone. 8788 is also claude's server default — export the scoped name
# to run both at once.
SERVER_HOST=127.0.0.1
OX_SERVER_PORT=8788

# Directory holding sanitized audit sidecars (the source of truth).
AUDIT_DIR=./logs/audit

# Path to the disposable SQLite materialized view.
DATABASE_PATH=./var/bike.db

# Timezone used for "today" boundaries in reports.
REPORT_TZ=America/New_York

# Boat body capture acceptance and retention: OFF by default. The proxy and
# server share CAPTURE_BODIES so both sides of the boundary opt in together.
# CAPTURE_BODIES=1
# Directory of redacted capture files (default: captures beside AUDIT_DIR).
# CAPTURE_DIR=./logs/captures
# Delete captures older than this many milliseconds (default: 7 days).
# CAPTURE_RETENTION_MS=604800000
# Total size cap across capture files, oldest deleted first (default: 256 MiB).
# CAPTURE_MAX_BYTES=268435456
