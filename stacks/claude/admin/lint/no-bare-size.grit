// A padding, margin, gap, font size or corner radius names a step of the scale
// declared in `@layer tokens`, never a bare pixel value.
//
// Reach for `var(--space-N)`, `var(--text-N)` or `var(--radius-N)`. If no step
// fits, add a *named* token beside `--space-page` rather than a literal.
//
// Scope is by file rather than by layer. The rule is meant to hold inside
// `@layer components`, but a `within \`@layer components { $_ }\`` clause
// compiles and then matches nothing. `tokens.css` holds only custom properties,
// which this pattern does not match.
//
// This plugin runs against every CSS file in the repo, not just this stack's:
// `plugins` in `biome.json` is a top-level array, and the path to this file says
// where it lives, not what it inspects. Biome 2.5.6 has no `overrides[].plugins`
// and no plugin suppression comment, so a sibling stack's bare px is rewritten
// against a named token in its own sheet rather than exempted here.
//
// The `[1-9]` guard is what lets a zero through, including the `0px` clamp
// floors in chat.css; a value with no px at all never matches.

language css

or {
  `padding: $v`,
  `padding-top: $v`,
  `padding-right: $v`,
  `padding-bottom: $v`,
  `padding-left: $v`,
  `padding-inline: $v`,
  `padding-inline-start: $v`,
  `padding-inline-end: $v`,
  `padding-block: $v`,
  `padding-block-start: $v`,
  `padding-block-end: $v`,
  `margin: $v`,
  `margin-top: $v`,
  `margin-right: $v`,
  `margin-bottom: $v`,
  `margin-left: $v`,
  `margin-inline: $v`,
  `margin-inline-start: $v`,
  `margin-inline-end: $v`,
  `margin-block: $v`,
  `margin-block-start: $v`,
  `margin-block-end: $v`,
  `gap: $v`,
  `row-gap: $v`,
  `column-gap: $v`,
  `font-size: $v`,
  `border-radius: $v`,
  `border-top-left-radius: $v`,
  `border-top-right-radius: $v`,
  `border-bottom-left-radius: $v`,
  `border-bottom-right-radius: $v`
} where {
  $v <: r".*[1-9][0-9.]*px.*",
  register_diagnostic(span=$v, message="Bare px in a size declaration. Pick a step from the scale in @layer tokens — var(--space-N), var(--text-N) or var(--radius-N) — so this cannot drift from the component beside it.")
}
