{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["node"],
    "noEmit": true,
    "allowImportingTsExtensions": true,
    // pnpm's hidden hoist directory keeps one `@types/react` for the whole store, picked by
    // install history rather than by the lockfile, and this workspace holds two React majors:
    // 18 here and in claude's admin, 19 in ox-alpha's. `lucide-react` and
    // `@tanstack/react-router` declare no `@types/react`, so TypeScript resolves the `react`
    // their `.d.ts` files import through that directory - and on an install that hoisted 19,
    // every icon and `<Link>` fails TS2786 while the same source passes on one that hoisted
    // 18. Pinning both specifiers resolves them for the whole program, dependency `.d.ts`
    // files included. Compile-time only: Vite resolves runtime imports itself.
    "paths": {
      "react": ["./node_modules/@types/react"],
      "react/*": ["./node_modules/@types/react/*"],
      "react-dom": ["./node_modules/@types/react-dom"],
      "react-dom/*": ["./node_modules/@types/react-dom/*"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
