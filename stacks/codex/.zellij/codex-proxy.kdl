layout {
    default_tab_template {
        pane size=1 borderless=true {
            plugin location="zellij:tab-bar"
        }
        children
        pane size=2 borderless=true {
            plugin location="zellij:status-bar"
        }
    }

    // One pane per Bike process. Plane's processes join this tab rather than a
    // second layout.
    tab name="dev" {
        pane split_direction="vertical" {
            // No port is pinned here. SERVER_PORT comes from server/.env; the
            // proxy reads PROXY_PORT from the environment it inherits.
            pane name="proxy" {
                command "pnpm"
                args "proxy"
            }
            pane split_direction="horizontal" {
                pane name="server" {
                    command "pnpm"
                    args "server"
                }
                pane name="admin" {
                    command "pnpm"
                    args "admin"
                }
            }
        }
    }

    tab name="shell" {
        pane
    }
}
