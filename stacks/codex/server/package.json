{
  "name": "server",
  "version": "0.1.0",
  "private": true,
  "description": "Local SQLite-backed usage API and live event server.",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "tsx --env-file-if-exists=.env src/server.ts",
    "typecheck": "node ../scripts/run-if-present.mjs src tsc --noEmit",
    "test": "node ../scripts/run-if-present.mjs test vitest run"
  },
  "dependencies": {
    "@codex-proxy/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
