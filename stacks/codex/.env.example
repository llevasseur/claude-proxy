# The ChatGPT OAuth flow `chadex` uses serves only /backend-api/codex/responses;
# api.openai.com 404s that path.
OPENAI_UPSTREAM=https://chatgpt.com
PROXY_HOST=127.0.0.1
# `chadex` calls 127.0.0.1:8026. Anything else needs the shell function updated too.
PROXY_PORT=8026
# The server reads HOST and CODEX_SERVER_PORT; `apps/admin` proxies /api to that port.
# The bare PORT is still honoured as a fallback for the server package alone, but one
# root .env would bind it to another stack too, so prefer the scoped name.
HOST=127.0.0.1
CODEX_SERVER_PORT=8798
# Relative paths resolve against the stack root, stacks/codex/ — not the launching cwd
# and not the repository root.
AUDIT_DIR=logs/audit
DATABASE_PATH=logs/codex-proxy.db
REPORT_TZ=America/New_York
# Status signal shared by the proxy (writer) and the server (reader).
PROXY_STATUS_FILE=logs/proxy-status.json
PROXY_STATUS_PATH=logs/proxy-status.json
