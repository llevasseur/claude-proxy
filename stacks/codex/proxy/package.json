{
  "name": "@agent-proxy/codex-proxy",
  "version": "0.1.0",
  "private": true,
  "description": "Zero-runtime-dependency transparent proxy for OpenAI/Codex traffic.",
  "type": "module",
  "bin": {
    "codex-proxy": "./src/proxy.ts"
  },
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node --env-file-if-exists=../../../.env src/proxy.ts",
    "typecheck": "node ../scripts/run-if-present.mjs src tsc --noEmit",
    "test": "node ../scripts/run-if-present.mjs test node --test --experimental-strip-types test/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.6.3"
  }
}
