{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "allowImportingTsExtensions": true,
    // The tests and the import script run under Node, driving the very same SQL
    // through `node:sqlite` — which is the whole reason the store is written
    // against a narrow `Db` port rather than against `D1Database` directly.
    "types": ["node"]
  },
  "include": ["src", "test", "scripts"]
}
