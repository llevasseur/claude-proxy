{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "claude-proxy-concepts",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "observability": { "enabled": true },

  // `database_id` is filled in by `wrangler d1 create concepts` — see README.
  // The placeholder is left in the file on purpose: a deploy against it fails
  // loudly rather than silently writing to the wrong database.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "concepts",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],

  // Daily backup commit. Off-peak in UTC; the exact minute does not matter.
  "triggers": { "crons": ["17 9 * * *"] },

  // Secrets (CONCEPTS_TOKEN, BACKUP_GITHUB_TOKEN) are set with
  // `wrangler secret put` and never appear here.
  "vars": {
    "BACKUP_REPO": "",
    "BACKUP_PATH": "concepts.jsonl",
    "BACKUP_BRANCH": "main"
  }
}
