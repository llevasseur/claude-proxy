{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "operator",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-09",
  "observability": { "enabled": true },

  // `database_id` is the existing `operator-db` D1 database — a D1 database id
  // is not a secret, so it is committed. Migrations live in `./migrations`,
  // which is wrangler's default.
  "d1_databases": [
    {
      "binding": "operator_db",
      "database_name": "operator-db",
      "database_id": "0f6e4159-6d40-4154-b796-a11b9bd609ad"
    }
  ],

  // Daily backup commit, off-peak in UTC.
  "triggers": { "crons": ["17 9 * * *"] },

  // Secrets (CONCEPTS_TOKEN, BACKUP_GITHUB_TOKEN) are set with
  // `wrangler secret put` and never appear here.
  "vars": {
    "BACKUP_REPO": "",
    "BACKUP_PATH": "concepts.jsonl",
    "BACKUP_BRANCH": "main"
  }
}
