{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    // Explicit `.ts` extensions on relative imports, as `proxy/` does.
    "allowImportingTsExtensions": true,
    // Cloudflare's types are imported where used rather than loaded as ambient
    // globals: alongside `@types/node` they collide on `Request`, `Response`
    // and `fetch`, and `tsconfig.test.json` compiles this same `src` under Node.
    "types": ["node"]
  },
  "include": ["src"]
}
