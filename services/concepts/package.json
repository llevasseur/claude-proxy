{
  "name": "concepts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Hosted concept store — the Cloudflare Worker and D1 database /teach writes to, read over REST and MCP.",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "schema:apply": "wrangler d1 migrations apply operator-db --remote",
    "schema:apply:local": "wrangler d1 migrations apply operator-db --local",
    "import": "tsx scripts/import-store.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@claude-proxy/core": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250801.0",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8",
    "wrangler": "^4.28.0"
  }
}
