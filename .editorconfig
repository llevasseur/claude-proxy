# Biome's formatter reads this file — `formatter.useEditorconfig` is `true` in
# biome.json, and until now it pointed at a file that did not exist in any of the
# three fused repositories. Every value below restates the setting biome.json
# already carries, so adding the file changes no formatting: it makes the editor
# and the gate agree instead of leaving the editor to guess.
#
# Keep the two in step. A value here that disagrees with biome.json wins for
# Biome as well as for the editor, so a stray edit reformats the whole tree and
# `pnpm check` goes red across files nobody touched.
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
max_line_length = 120
trim_trailing_whitespace = true

# Two trailing spaces are a hard line break in Markdown, so trimming them edits
# prose. Biome does not read this key; it is here for the editor.
[*.md]
trim_trailing_whitespace = false
