layout {
    default_tab_template {
        pane size=1 borderless=true {
            plugin location="zellij:tab-bar"
        }
        children
        pane size=2 borderless=true {
            plugin location="zellij:status-bar"
        }
    }

    // One pane per Bike process. Plane's processes join this tab rather than a
    // second layout.
    tab name="dev" {
        pane split_direction="vertical" {
            // `cwd` on every pane is load-bearing, not tidy: scripts/zellij.sh
            // launches from the monorepo root, where a bare `pnpm proxy` resolves
            // to claude's root script. `cwd` picks `stacks/codex/package.json`
            // instead, and lets each script's `--env-file-if-exists=../../../.env`
            // reach this stack's root `.env` from the package directory.
            //
            // No port is pinned here; each pane reads its own env. codex's
            // defaults are proxy 8026 and server 4319 — see .zellij/README.md
            // for all nine.
            pane name="proxy" {
                cwd "stacks/codex"
                command "pnpm"
                args "proxy"
            }
            pane split_direction="horizontal" {
                pane name="server" {
                    cwd "stacks/codex"
                    command "pnpm"
                    args "server"
                }
                pane name="admin" {
                    cwd "stacks/codex"
                    command "pnpm"
                    args "admin"
                }
            }
        }
    }

    tab name="shell" {
        pane
    }
}
