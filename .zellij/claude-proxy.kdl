layout {
    default_tab_template {
        pane size=1 borderless=true {
            plugin location="zellij:tab-bar"
        }
        children
        pane size=2 borderless=true {
            plugin location="zellij:status-bar"
        }
    }

    tab name="dev" {
        pane split_direction="vertical" {
            pane name="proxy" {
                // Proxy reads PORT; 8787 (its default) conflicts on this machine, and
                // layouts can't set env directly, so pass it inline via a shell. 8036
                // is a machine-local override, not the default — see .zellij/README.md
                // for all nine. These panes need no `cwd`: this stack's scripts are
                // the monorepo root's, which is where scripts/zellij.sh launches from.
                command "sh"
                args "-c" "PORT=8036 pnpm proxy"
            }
            pane split_direction="horizontal" {
                pane name="server" {
                    command "pnpm"
                    args "server"
                }
                pane name="admin" {
                    command "pnpm"
                    args "admin"
                }
                // net's server, in claude's session because claude's admin is its only
                // reader — the Overview's internet-spend card and the `/internet` page
                // fetch it at 8531 — and the hourly collector lives inside this same
                // process (decision internet-spend 005), so hours it is down stay
                // missing. The one cross-stack pane in any layout;
                // `.zellij/net-server.kdl` still opens net alone.
                //
                // `cwd` as in the sibling layouts: this layout launches from the
                // monorepo root, where a bare `pnpm server` is claude's script. No port
                // pinned — net-server resolves its own default 8531.
                pane name="net-server" {
                    cwd "stacks/net"
                    command "pnpm"
                    args "server"
                }
            }
        }
    }

    tab name="shell" {
        pane
    }
}
