layout {
    default_tab_template {
        pane size=1 borderless=true {
            plugin location="zellij:tab-bar"
        }
        children
        pane size=2 borderless=true {
            plugin location="zellij:status-bar"
        }
    }

    tab name="dev" {
        pane split_direction="vertical" {
            pane name="proxy" {
                // Proxy reads PORT; 8787 (its default) conflicts on this machine, and
                // layouts can't set env directly, so pass it inline via a shell. 8036
                // is a machine-local override, not the default — see .zellij/README.md
                // for all nine. These panes need no `cwd`: this stack's scripts are
                // the monorepo root's, which is where scripts/zellij.sh launches from.
                command "sh"
                args "-c" "PORT=8036 pnpm proxy"
            }
            pane split_direction="horizontal" {
                pane name="server" {
                    command "pnpm"
                    args "server"
                }
                pane name="admin" {
                    command "pnpm"
                    args "admin"
                }
                // net's server, in claude's session because claude's admin is what
                // reads it: the Overview's internet-spend card and the `/internet`
                // page fetch net-server at 8531, and with that process down the card
                // renders "net-server unreachable" — and the hourly collector, which
                // lives inside this same process (decision internet-spend 005), takes
                // no samples either, so the gap outlives the session. This pane is the
                // one cross-stack pane in any layout, and it is a consumer pane rather
                // than net's own session: `.zellij/net-server.kdl` still opens net
                // alone, for work on the net stack itself.
                //
                // `cwd` is load-bearing, exactly as it is in the sibling layouts: this
                // layout launches from the monorepo root, where a bare `pnpm server`
                // resolves to the *root* script, which is claude's. It pins no port —
                // net-server resolves its own default 8531, which collides with
                // nothing.
                pane name="net-server" {
                    cwd "stacks/net"
                    command "pnpm"
                    args "server"
                }
            }
        }
    }

    tab name="shell" {
        pane
    }
}
