layout {
    default_tab_template {
        pane size=1 borderless=true {
            plugin location="zellij:tab-bar"
        }
        children
        pane size=2 borderless=true {
            plugin location="zellij:status-bar"
        }
    }

    tab name="dev" {
        pane split_direction="vertical" {
            pane name="proxy" {
                // Proxy reads PORT; 8787 (its default) conflicts on this machine.
                // Layouts can't set env directly, so pass it inline via a shell.
                //
                // 8036 is an override for this machine, not a default — the
                // default is still 8787 and is recorded in .zellij/README.md
                // with the other eight. These panes need no `cwd`: this stack's
                // scripts are the monorepo root's, which is where
                // scripts/zellij.sh launches from. The sibling layouts do need
                // one, and say why.
                command "sh"
                args "-c" "PORT=8036 pnpm proxy"
            }
            pane split_direction="horizontal" {
                pane name="server" {
                    command "pnpm"
                    args "server"
                }
                pane name="admin" {
                    command "pnpm"
                    args "admin"
                }
            }
        }
    }

    tab name="shell" {
        pane
    }
}
