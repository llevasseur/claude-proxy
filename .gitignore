# No trailing slash: in a worktree `logs` is a symlink
# (scripts/bootstrap-worktree.sh), which `logs/` would not match.
logs
.skim-cache/
.DS_Store
node_modules/
dist/
build/
coverage/
*.tsbuildinfo
.env
.env.*
!.env.example
.vite/
# Local miniflare/wrangler state (D1, cache, traces) — regenerated on `wrangler dev`
.wrangler/
tmp/*
!tmp/.gitkeep
# Project skills are tracked under `.agents/skills/`; `.claude/skills/` only surfaces
# them for Claude Code, and is rebuilt per checkout by scripts/link-project-skills.sh.
.claude/skills/
# net stack's local sample database, anchored at stacks/net/data per ADR 0054
stacks/net/data/
# my-command-tools writes this per worktree to track a branch's screenshot runs. It is
# already ignored globally on this device, but Biome reads the repository's .gitignore
# alone (`vcs.useIgnoreFile`) — so without this line `check` walks it and fails on its
# formatting in every toolkit-created worktree, on a file no one wrote or commits.
.my-command/