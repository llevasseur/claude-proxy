# No trailing slash: in a worktree `logs` is a symlink
# (scripts/bootstrap-worktree.sh), which `logs/` would not match.
logs
.skim-cache/
.DS_Store
node_modules/
dist/
build/
coverage/
*.tsbuildinfo
.env
.env.*
!.env.example
.vite/
# Local miniflare/wrangler state (D1, cache, traces) — regenerated on `wrangler dev`
.wrangler/
tmp/*
!tmp/.gitkeep
# Project skills are tracked under `.agents/skills/`; `.claude/skills/` only surfaces
# them for Claude Code, and is rebuilt per checkout by scripts/link-project-skills.sh.
.claude/skills/
# net stack's local sample database, anchored at stacks/net/data per ADR 0054
stacks/net/data/