{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // No `rootDir`: the parity test reaches out of the package into `proxy/`.
    "noEmit": true,
    // Only for the parity test's import of `proxy/session.ts`; the package itself
