{
  "name": "claude-proxy-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Logging proxy for Claude Code plus an admin dashboard that monitors usage, trends, and advice from the captured audit logs.",
  "type": "module",
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "setup:env": "bash scripts/proxy-store-env.sh --setup",
    "check:env": "bash scripts/proxy-store-env.sh --check",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "build": "pnpm -r --if-present build",
    "lint": "biome lint .",
    "lint:anti-slop": "oxlint",
    "anti:slop": "oxlint",
    "format": "biome check --write .",
    "check": "biome check . && node scripts/check-package-filters.mjs",
    "check:names": "node scripts/check-package-filters.mjs",
    "proxy": "pnpm --filter proxy start",
    "server": "pnpm --filter server dev",
    "admin": "pnpm --filter admin dev",
    "summary": "pnpm --filter server summary",
    "zellij": "bash scripts/zellij.sh",
    "skills:link": "bash scripts/link-project-skills.sh",
    "postinstall": "pnpm run skills:link"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@oxlint/plugins": "1.78.0",
    "oxlint": "1.78.0"
  }
}
