# Ceilings for the estimated usage meters, in the weighted metering unit:
# input + output + cacheCreation + (cacheRead × 0.02). Regenerate for your own
# device with `node scripts/derive-metering-weight.mjs`.
#
# A ceiling set too HIGH makes the meter read usage too LOW. These are this
# device's, rounded down from what the utilization headers imply (~19M per
# 5-hour window, ~154M per week).
USAGE_LIMIT_5H=18m
USAGE_LIMIT_WEEK=150m

# The hosted concept store — `services/concepts`, deployed as the `operator`
# Worker. With BOTH set, the Concepts page reads the corpus `/teach` saves from
# every device; with either unset it falls back to `logs/concepts.jsonl` and the
# page says so. The token is the one `wrangler secret put CONCEPTS_TOKEN` holds
# — keep the authoritative copy in a password manager, never in git.
# CONCEPTS_URL=https://…
# CONCEPTS_TOKEN=…
