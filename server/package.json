{
  "name": "server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "API over proxy logs with scoped local writes, plus a headless daily-summary job.",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "tsx --env-file-if-exists=.env src/server.ts",
    "summary": "tsx src/daily-summary.ts",
    "suggestions": "tsx src/suggestions-cli.ts",
    "ideas": "tsx src/ideas-cli.ts",
    "maintain": "tsx --env-file-if-exists=.env src/maintain-cli.ts",
    "ingest": "tsx --env-file-if-exists=.env src/ingest-cli.ts",
    "prompt-backfill": "tsx --env-file-if-exists=.env src/prompt-backfill-cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@claude-proxy/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
