<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Nightly log lifecycle for claude-proxy: archive yesterday's logs, evict bodies
  past RETENTION_DAYS, print the digest. Replaces com.llevasseur.claude-usage-summary,
  whose pruner deleted whole archive/<date>/ directories — sidecars included.

  Install (this file is the reviewable copy; ~/Library/LaunchAgents/ holds the live one):

      cp scripts/com.llevasseur.claude-proxy.maintain.plist ~/Library/LaunchAgents/
      launchctl unload ~/Library/LaunchAgents/com.llevasseur.claude-proxy.maintain.plist 2>/dev/null
      launchctl load  ~/Library/LaunchAgents/com.llevasseur.claude-proxy.maintain.plist

  Dry-run it by hand any time with `pnpm --filter server maintain` (no --apply).
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.llevasseur.claude-proxy.maintain</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/llevasseur/Library/pnpm/bin/pnpm</string>
        <string>--filter</string>
        <string>server</string>
        <string>maintain</string>
        <string>--apply</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/llevasseur/Documents/ghub/claude-proxy</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/Users/llevasseur/Library/pnpm/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <!-- LOG_DIR is the variable the CLI reads (resolveLogDir in server/src/logs.ts);
             CLAUDE_PROXY_LOGS is set alongside it as the documented name. -->
        <key>LOG_DIR</key>
        <string>/Users/llevasseur/Documents/ghub/claude-proxy/logs</string>
        <key>CLAUDE_PROXY_LOGS</key>
        <string>/Users/llevasseur/Documents/ghub/claude-proxy/logs</string>
        <key>RETENTION_DAYS</key>
        <string>30</string>
        <key>TIMEZONE</key>
        <string>America/Toronto</string>
    </dict>

    <!-- 21:00 daily — the slot the replaced job used. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>21</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>RunAtLoad</key>
    <false/>
    <key>KeepAlive</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/Users/llevasseur/.claude-usage/logs/maintain.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/llevasseur/.claude-usage/logs/maintain.log</string>
</dict>
</plist>
